        <mxCell id="edge3" edge="1" parent="1" source="user-choice" target="user-menu1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=1.5;">
