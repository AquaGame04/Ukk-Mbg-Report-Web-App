        </mxCell>
        
        <mxCell id="edge17" edge="1" parent="1" source="user-continue" target="user-end" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;">
