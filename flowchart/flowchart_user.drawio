<mxfile host="app.diagrams.net">
  <diagram name="User Flowchart" id="user-flow-diagram">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="850" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        
        <!-- Start -->
        <mxCell id="user-start" value="Mulai" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#4CAF50;fontColor=#fff;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="350" y="20" width="60" height="60" as="geometry" />
        </mxCell>
        
        <!-- Main Landing Page -->
        <mxCell id="user-main" value="Halaman Utama" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#2196F3;fontColor=#fff;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="310" y="120" width="140" height="60" as="geometry" />
        </mxCell>
        
        <!-- Choice -->
        <mxCell id="user-choice" value="Pilih Menu" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FF9800;strokeWidth=2;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="335" y="230" width="90" height="80" as="geometry" />
        </mxCell>
        
        <!-- Menu Options -->
        <mxCell id="user-menu1" value="Menu Hari Ini" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#2196F3;fontColor=#fff;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="50" y="360" width="100" height="50" as="geometry" />
        </mxCell>
        
        <mxCell id="user-menu2" value="Riwayat Menu" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#2196F3;fontColor=#fff;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="180" y="360" width="100" height="50" as="geometry" />
        </mxCell>
        
        <mxCell id="user-menu3" value="Tim SPPG" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#2196F3;fontColor=#fff;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="310" y="360" width="100" height="50" as="geometry" />
        </mxCell>
        
        <mxCell id="user-menu4" value="Buat Pengaduan" style="rounded=1;whiteSpace=wrap;html=1;fillColor:#2196F3;fontColor=#fff;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="440" y="360" width="100" height="50" as="geometry" />
        </mxCell>
        
        <mxCell id="user-menu5" value="Lihat Pengaduan" style="rounded=1;whiteSpace=wrap;html=1;fillColor:#2196F3;fontColor=#fff;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="570" y="360" width="100" height="50" as="geometry" />
        </mxCell>
        
        <!-- View Data -->
        <mxCell id="user-view" value="Tampilkan Data" style="rounded=1;whiteSpace=wrap;html=1;fillColor:#00BCD4;fontColor=#fff;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="310" y="470" width="140" height="60" as="geometry" />
        </mxCell>
        
        <!-- Complaint Process -->
        <mxCell id="user-form" value="Isi Form Pengaduan" style="rounded=1;whiteSpace=wrap;html=1;fillColor:#9C27B0;fontColor=#fff;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="440" y="470" width="100" height="60" as="geometry" />
        </mxCell>
        
        <mxCell id="user-upload" value="Upload Foto" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#9C27B0;fontColor=#fff;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="440" y="570" width="100" height="60" as="geometry" />
        </mxCell>
        
        <!-- Continue Decision -->
        <mxCell id="user-continue" value="Lanjut?" style="rhombus;whiteSpace=wrap;html=1;fillColor:#F44336;strokeWidth=2;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="345" y="670" width="70" height="70" as="geometry" />
        </mxCell>
        
        <!-- End -->
        <mxCell id="user-end" value="Selesai" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#F44336;fontColor=#fff;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="365" y="800" width="60" height="60" as="geometry" />
        </mxCell>
        
        <!-- Edges -->
        <mxCell id="edge1" edge="1" parent="1" source="user-start" target="user-main" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        
        <mxCell id="edge2" edge="1" parent="1" source="user-main" target="user-choice" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;">
