        <mxCell id="edge9" edge="1" parent="1" source="user-menu2" target="user-view" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=1;dashed=1;">
