        <mxCell id="edge8" edge="1" parent="1" source="gizi-m1" target="gizi-a1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=1;dashed=1;">
