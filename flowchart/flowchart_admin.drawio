<mxfile host="app.diagrams.net">
  <diagram name="Admin Flowchart" id="admin-flow-diagram">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="850" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        
        <!-- Start -->
        <mxCell id="admin-start" value="Mulai" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#4CAF50;fontColor=#fff;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="350" y="20" width="60" height="60" as="geometry" />
        </mxCell>
        
        <!-- Login -->
        <mxCell id="admin-login" value="Login Admin" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#2196F3;fontColor=#fff;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="310" y="120" width="140" height="60" as="geometry" />
        </mxCell>
        
        <!-- Dashboard -->
        <mxCell id="admin-dashboard" value="Dashboard Admin" style="rounded=1;whiteSpace=wrap;html=1;fillColor:#2196F3;fontColor=#fff;strokeWidth=2;" vertex="1" parent="1">
