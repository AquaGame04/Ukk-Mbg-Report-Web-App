        <!-- Menu Options -->
        <mxCell id="admin-m1" value="Kelola User" style="rounded=1;whiteSpace=wrap;html=1;fillColor:#9C27B0;fontColor=#fff;strokeWidth=1.5;" vertex="1" parent="1">
